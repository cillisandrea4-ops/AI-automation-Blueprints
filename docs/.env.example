# ─────────────────────────────────────────────────────────────
# AI Automation Blueprints — environment template
# Copy to .env and fill in. Never commit the filled file.
# ─────────────────────────────────────────────────────────────

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Webhook path registered in n8n. Change this: do not ship the example value.
N8N_WEBHOOK_PATH=executive-summary

# Optional — delivery targets
SLACK_WEBHOOK_URL=
NOTION_DATABASE_ID=

# Optional — guardrails
MAX_PAYLOAD_BYTES=8192
MAX_RETRIES=2
